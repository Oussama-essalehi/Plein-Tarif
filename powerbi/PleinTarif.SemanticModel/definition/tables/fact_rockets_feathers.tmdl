	partition fact_rockets_feathers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_rockets_feathers.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    // culture en-US: the CSV files use '.' as decimal separator whatever the Windows locale
				    Typed = Table.TransformColumnTypes(Promoted, {{"fuel_key", Int64.Type}, {"fuel_code", type text}, {"horizon_weeks", Int64.Type}, {"direction", type text}, {"cumulative_response", type number}, {"ci_low", type number}, {"ci_high", type number}, {"sample", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
