	column fuel_key
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 5c3bd73b-4312-5a9e-b4c0-c15ae8ee528a
		summarizeBy: none
		sourceColumn: fuel_key

		annotation SummarizationSetBy = Automatic

	column fuel_code
