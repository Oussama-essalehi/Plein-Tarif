	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    // culture en-US: the CSV files use '.' as decimal separator whatever the Windows locale
				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"iso_week", Int64.Type}, {"weekday_num", Int64.Type}, {"weekday_name", type text}, {"is_weekend", type logical}, {"is_holiday", type logical}, {"holiday_name", type text}, {"is_day_before_holiday_or_weekend", type logical}, {"discount_ht", type number}, {"discount_label", type text}, {"event_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
