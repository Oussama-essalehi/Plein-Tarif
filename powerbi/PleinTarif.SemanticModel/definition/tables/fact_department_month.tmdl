	partition fact_department_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_department_month.csv"), [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    // culture en-US: the CSV files use '.' as decimal separator whatever the Windows locale
				    Typed = Table.TransformColumnTypes(Promoted, {{"month_date_key", Int64.Type}, {"year_month", type text}, {"department", type text}, {"region", type text}, {"fuel_key", Int64.Type}, {"n_stations", Int64.Type}, {"n_days", Int64.Type}, {"n_station_days", Int64.Type}, {"price_ttc_median", type number}, {"price_ttc_mean", type number}, {"price_ht_mean", type number}, {"price_ttc_sum", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
