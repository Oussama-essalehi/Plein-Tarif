	partition dim_station = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_station.csv"), [Delimiter=",", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    // culture en-US: the CSV files use '.' as decimal separator whatever the Windows locale
				    Typed = Table.TransformColumnTypes(Promoted, {{"station_key", Int64.Type}, {"station_id", Int64.Type}, {"lat", type number}, {"lon", type number}, {"address", type text}, {"postcode", type text}, {"city", type text}, {"city_std", type text}, {"department", type text}, {"region_code", type text}, {"region", type text}, {"zone", type text}, {"tax_zone", type text}, {"is_motorway", type logical}, {"road_type", type text}, {"automate_24_24", type logical}, {"brand", type text}, {"brand_category", type text}, {"brand_category_label", type text}, {"osm_match_distance_m", type number}, {"brand_ambiguous", type logical}, {"first_year", Int64.Type}, {"last_year", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
